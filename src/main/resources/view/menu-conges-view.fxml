<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="mainBorderPane" minHeight="700.0" minWidth="1100.0" prefHeight="700.0" prefWidth="1100.0" stylesheets="@../css/menu-conges.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuCongesController">
   <left>
      <VBox fx:id="sidebarVBox" alignment="TOP_CENTER" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <StackPane fx:id="logoIcon" prefHeight="80.0" prefWidth="182.0" styleClass="logo-icon" />

            <Button fx:id="dashboardButton" mnemonicParsing="false" styleClass="nav-button" text="Dashboard" />
            <Button fx:id="congeesButton" mnemonicParsing="false" styleClass="active-button" text="Congees" />
            <Button fx:id="employeesButton" mnemonicParsing="false" styleClass="nav-button" text="Employees" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="supportButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="170.0" text="Support">
               <graphic>
                  <ImageView fitHeight="20.0" fitWidth="20.0" opacity="0.8">
                     <image><Image url="@../img/support.png" /></image>
                  </ImageView>
               </graphic>
            </Button>

            <Button fx:id="logoutButton" mnemonicParsing="false" text="Logout">
               <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Button>
         </children>
      </VBox>
   </left>

   <center>
      <VBox fx:id="mainContentVBox" BorderPane.alignment="CENTER">
         <children>
            <HBox fx:id="topBarHBox">
               <children>
                  <TextField fx:id="searchTextField" promptText="Search..." HBox.hgrow="ALWAYS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="notificationButton" mnemonicParsing="false" text="🔔" />
                  <ComboBox fx:id="profileComboBox" promptText="Profile" />
               </children>
            </HBox>

            <HBox fx:id="headerHBox" alignment="CENTER_LEFT" prefHeight="80.0" spacing="10.0">
               <children>
                  <Text fx:id="pageTitleText" text="Gestion Des Conges" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="exportCsvButton" mnemonicParsing="false" text="Export CSV" />
                  <Button fx:id="addRequestButton" mnemonicParsing="false" text="Ajouter une Demande +" />
               </children>
               <padding><Insets left="20.0" right="20.0" /></padding>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>

            <HBox fx:id="contentAreaHBox" spacing="20.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox fx:id="filtersVBox" minWidth="200.0" spacing="10.0">
                     <children>
                        <Label fx:id="filtersLabel" text="Filters" />
                        <Button fx:id="allFilterButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="All" />
                        <Button fx:id="pendingFilterButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Pending" />
                        <Button fx:id="approvedFilterButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Approved" />
                        <Button fx:id="rejectedFilterButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Rejected" />
                     </children>
                     <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                  </VBox>

                  <ListView fx:id="congesListView" HBox.hgrow="ALWAYS" />
               </children>
               <padding><Insets bottom="20.0" left="20.0" right="20.0" /></padding>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
